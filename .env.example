# Copy to .env and fill in. Every value can also be set as an environment variable.

# Backend: local | azure
BRIDGE_BACKEND=local
# Transport: stdio | http
BRIDGE_TRANSPORT=stdio

# --- local backend: folder holding *.md briefs ---
BRIDGE_BRIEFS_DIR=~/briefs

# --- azure backend ---
BRIDGE_STORAGE_ACCOUNT=
BRIDGE_CONTAINER=briefs
BRIDGE_SAS_TOKEN=

# --- http transport (required when BRIDGE_TRANSPORT=http) ---
BRIDGE_API_KEY=
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8000
